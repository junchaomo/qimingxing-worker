# =============================================================
# qimingxing ASR Worker 环境变量示例
# 复制为 worker/.env 并填入真实值（.env 已被 gitignore）
# =============================================================

# --- 数据库（Supabase 项目 Settings -> Database -> Connection string）---
DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres

# --- Supabase Storage（下载原始音频，用 Service Role Key）---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
STORAGE_BUCKET=audio

# --- DashScope / Qwen-ASR（百炼控制台申请）---
# sk-ws- 开头的 Key 为业务空间专属 Key，必须同时配置业务空间专属网关域名 DASHSCOPE_BASE_URL
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_MODEL=qwen-audio-3.0-asr-flash
# 业务空间专属网关：在百炼控制台「API Key」页面查看 OpenAI compatible 地址
# 例如 https://llm-xxxxxxxxxx.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# 音频输入规格（须与 audio.py 转换输出一致：16kHz 单声道 wav）
ASR_AUDIO_FORMAT=wav
ASR_SAMPLE_RATE=16000
ENABLE_ITN=true

# --- 并发与限流 ---
WORKER_CONCURRENCY=4
GLOBAL_API_SEMAPHORE=16

# --- VAD 分段 ---
VAD_SEGMENT_THRESHOLD_S=120
MAX_SEGMENT_S=180

# --- 轮询与重试 ---
POLL_INTERVAL_S=5
SEGMENT_MAX_RETRIES=3
TASK_MAX_RETRIES=2

# --- 本地临时目录 ---
TMP_DIR=./tmp

# --- FFmpeg 定位 ---
# 生产环境把 ffmpeg/ffprobe 加入系统 PATH 即可，无需此配置；
# 本地若未加入 PATH，可显式指定 bin 目录，例如：
# FFMPEG_BIN_DIR=C:\path\to\ffmpeg-7.0-full_build\bin

# =============================================================
# qimingxing ASR Worker 环境变量示例
# 复制为 worker/.env 并填入真实值（.env 已被 gitignore）
# =============================================================

# --- 数据库（Supabase 项目 Settings -> Database -> Connection string）---
DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres

# --- Supabase Storage（下载原始音频，用 Service Role Key）---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
STORAGE_BUCKET=audio

# --- 阿里云 OSS（Filetrans 音频中转，重要）---
# DashScope Filetrans 需要公网下载音频 URL，但阿里服务器访问 Supabase 不稳定（FILE_DOWNLOAD_FAILED）。
# 因此把临时音频上传到阿里 OSS，用签名 URL 提供给 DashScope。阿里访问自家 OSS 稳定。
# 在阿里云控制台创建 OSS Bucket（建议北京 cn-beijing），并创建 AccessKey。
# OSS_ACCESS_KEY_ID=your_access_key_id
# OSS_ACCESS_KEY_SECRET=your_access_key_secret
# OSS_BUCKET=your-bucket-name
# OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com

# --- DashScope / Qwen-ASR（百炼控制台申请）---
# sk-ws- 开头的 Key 为业务空间专属 Key，必须同时配置业务空间专属网关域名 DASHSCOPE_BASE_URL
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# 使用 Filetrans 异步模型，支持阿里自带的说话人分离（多人声识别）
DASHSCOPE_MODEL=qwen-audio-3.0-asr-flash-filetrans
# Filetrans 异步任务接口（旧域名仍可用，无需 WorkspaceId）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# 音频输入规格（须与 audio.py 转换输出一致：16kHz 单声道 wav）
ASR_AUDIO_FORMAT=wav
ASR_SAMPLE_RATE=16000
ENABLE_ITN=true

# --- 并发与限流 ---
WORKER_CONCURRENCY=4       # 每任务内并发段数
WORKER_THREADS=5           # Worker 进程内并发任务数
GLOBAL_API_SEMAPHORE=20    # 全局同时进行的 API 请求上限

# --- VAD 分段 ---
VAD_SEGMENT_THRESHOLD_S=30   # 目标分段时长（按句子切分）
MAX_SEGMENT_S=60             # 单段硬上限（1分钟，更细粒度）
MIN_SPEECH_MS=500            # 最短语音段
MIN_SILENCE_MS=300           # 静音检测阈值

# --- 轮询与重试 ---
POLL_INTERVAL_S=5
SEGMENT_MAX_RETRIES=3
TASK_MAX_RETRIES=2
API_TIMEOUT_S=120

# --- 本地临时目录 ---
TMP_DIR=./tmp

# --- FFmpeg 定位 ---
# 生产环境把 ffmpeg/ffprobe 加入系统 PATH 即可，无需此配置；
# 本地若未加入 PATH，可显式指定 bin 目录，例如：
# FFMPEG_BIN_DIR=C:\path\to\ffmpeg-7.0-full_build\bin
